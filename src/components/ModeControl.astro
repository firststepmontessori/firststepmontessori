<div class="mode-control" role="group" aria-label="Colour mode">
  <button type="button" data-mode-choice="system" aria-pressed="true" title="Follow device colour mode"><span aria-hidden="true">◐</span><span class="mode-label">System</span></button>
  <button type="button" data-mode-choice="light" aria-pressed="false" title="Use light mode"><span aria-hidden="true">☀</span><span class="mode-label">Light</span></button>
  <button type="button" data-mode-choice="night" aria-pressed="false" title="Use night mode"><span aria-hidden="true">☾</span><span class="mode-label">Night</span></button>
</div>
