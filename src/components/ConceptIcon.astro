---
type IconName = "hands-on" | "choice" | "independence" | "respect" | "order" | "curiosity" | "prepared" | "routine" | "environment" | "care";
interface Props { name: IconName }
const { name } = Astro.props;
---
<span class="concept-icon" aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none">
    {name === "hands-on" && <><path d="M8 30c5-4 8-5 12-2l4 3 7-8c2-2 5 1 3 3l-8 11c-2 3-5 4-9 2l-9-4"/><path d="M16 25V13m0 0 5 5m-5-5-5 5"/><circle cx="34" cy="13" r="5"/></>}
    {name === "choice" && <><path d="M8 11h10v10H8zm22 0h10v10H30zM19 30h10v10H19z"/><path d="M13 25v4h11m11-4v4H24V21"/></>}
    {name === "independence" && <><path d="M9 37 24 11l15 26"/><path d="M14 29h20M19 21h10M24 11v29"/></>}
    {name === "respect" && <><path d="M24 39S9 30 9 19c0-8 10-11 15-4 5-7 15-4 15 4 0 11-15 20-15 20Z"/><path d="M18 24c3 3 9 3 12 0"/></>}
    {name === "order" && <><rect x="8" y="9" width="32" height="30" rx="3"/><path d="M8 19h32M18 19v20M29 19v20"/><circle cx="13" cy="14" r="1"/><circle cx="18" cy="14" r="1"/></>}
    {name === "curiosity" && <><circle cx="21" cy="21" r="11"/><path d="m29 29 10 10M17 18c2-4 8-3 8 1 0 3-4 3-4 7m0 4h.01"/></>}
    {name === "prepared" && <><path d="M8 37h32M11 37V16h26v21M16 16V9h16v7"/><path d="M16 24h6v6h-6zm10 0h6v6h-6z"/></>}
    {name === "routine" && <><circle cx="24" cy="24" r="16"/><path d="M24 14v11l8 5M9 13l5-4m25 4-5-4"/></>}
    {name === "environment" && <><path d="M7 39h34M11 39V19l13-9 13 9v20"/><path d="M18 39V27h12v12M33 13c3-4 7-3 8 1-4 2-7 1-8-1Z"/></>}
    {name === "care" && <><path d="M7 31c5-3 9-3 13 0l4 3 8-6c3-2 6 2 3 4l-9 8c-2 2-5 2-8 0L7 35"/><path d="M24 26s-8-5-8-11c0-5 6-7 8-3 3-4 8-2 8 3 0 6-8 11-8 11Z"/></>}
  </svg>
</span>
