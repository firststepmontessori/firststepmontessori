---
import { SITE_THEME } from "../lib/theme";
---
{SITE_THEME === "garden" ? (
  <div class="hero-art garden-art" role="img" aria-label="Abstract wooden learning blocks surrounded by botanical line drawings">
    <svg class="stem stem-one" viewBox="0 0 160 300" aria-hidden="true"><path d="M78 290C70 220 72 142 95 22M82 230C48 205 35 180 28 151M86 187c35-21 48-46 53-72M91 132C62 111 52 85 51 59M96 91c29-18 39-39 42-60M51 188c-20-1-34 6-45 19M119 134c18-1 30 5 39 18M53 83C35 81 23 88 13 101M121 52c15 0 25 6 33 18" /></svg>
    <svg class="stem stem-two" viewBox="0 0 160 300" aria-hidden="true"><path d="M78 290C70 220 72 142 95 22M82 230C48 205 35 180 28 151M86 187c35-21 48-46 53-72M91 132C62 111 52 85 51 59M96 91c29-18 39-39 42-60M51 188c-20-1-34 6-45 19M119 134c18-1 30 5 39 18M53 83C35 81 23 88 13 101M121 52c15 0 25 6 33 18" /></svg>
    <span class="sun"></span><span class="block block-one"></span><span class="block block-two"></span><span class="block block-three"></span>
  </div>
) : (
  <div class="hero-art geometry-art" role="img" aria-label="A joyful landscape assembled from colourful geometric learning shapes">
    <div class="shape-stage"><span class="shape shape-circle"></span><span class="shape shape-arch"></span><span class="shape shape-square"></span><span class="shape shape-house"></span><span class="shape shape-dot"></span></div>
  </div>
)}
