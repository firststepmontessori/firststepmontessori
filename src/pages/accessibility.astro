---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getSiteDocument } from "../content/site";
const site = await getSiteDocument();
---
<BaseLayout site={site} title="Accessibility" pathname="/accessibility">
  <PageHero label="Accessibility" title="Designed to be clear, calm and usable" introduction="We want families to be able to understand the school’s information and move around the website comfortably on different devices." />
  <article class="section surface-section policy"><div class="narrow"><h2>Reading and navigation</h2><p>Pages use clear headings, descriptive links, readable text and visible keyboard focus. The layout adapts to phones, tablets and larger screens.</p><h2>Colour and movement</h2><p>The System setting follows your device’s colour preference. You may also choose Light or Night. If your device asks websites to reduce motion, decorative movement is kept to a minimum.</p><h2>Other services</h2><p>WhatsApp, Instagram and Google Maps are provided by other organisations, so their accessibility may differ from this website.</p><h2>Tell us what is difficult</h2><p>If any page or action is hard to use, email <a href={`mailto:${site.settings.email}`}>{site.settings.email}</a>. Please include the page address and a short description so we can investigate.</p></div></article>
</BaseLayout>
