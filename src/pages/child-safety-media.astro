---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getSiteDocument } from "../content/site";
const site = await getSiteDocument();
---
<BaseLayout site={site} title="Child safety and media policy" pathname="/child-safety-media">
  <PageHero label="Child safety" title="Children’s privacy comes before decoration" introduction="This website currently uses words, colour and original illustrations instead of photographs or videos of children." />
  <article class="section surface-section policy"><div class="narrow"><h2>Our current media rule</h2><p>No photograph or video showing a child appears on this website. We also avoid stock pictures and computer-generated pictures of children.</p><h2>If photographs are considered later</h2><p>The school will first explain exactly how an image would be used and ask the child’s parent or legal guardian for clear permission. Saying no must not affect the child’s place at school, and permission may be withdrawn.</p><h2>Respectful use</h2><p>Any future image must be appropriate, limited to its agreed purpose and removed promptly when permission is withdrawn. Private family information will not be displayed alongside it.</p><h2>Reporting a concern</h2><p>If you notice anything that concerns you, email <a href={`mailto:${site.settings.email}`}>{site.settings.email}</a> or call <a href={`tel:${site.settings.phone.replace(/\s/g, "")}`}>{site.settings.phone}</a>.</p></div></article>
</BaseLayout>
