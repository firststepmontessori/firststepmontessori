---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { getSiteDocument } from "../content/site";
const site = await getSiteDocument();
---
<BaseLayout site={site} title="Privacy" pathname="/privacy">
  <PageHero label="Privacy" title="Useful information without unnecessary collection" introduction="Families can explore the school and contact us directly without submitting personal details through this website." />
  <article class="section surface-section policy"><div class="narrow"><h2>What we ask from you</h2><p>This website has no enquiry form, parent account or child profile. You can read every public page without giving us your name, phone number or email address.</p><h2>When you contact the school</h2><p>If you choose to call, email or message the school, please share only the information needed for your enquiry. The school will handle that conversation directly.</p><h2>Links to other services</h2><p>Links to WhatsApp, Instagram and Google Maps open services provided by other organisations. Their own privacy choices and terms apply after you follow a link.</p><h2>Your display preference</h2><p>If you choose Light, Night or System mode, that choice is remembered on your device so the website can appear the same way on your next visit.</p><h2>Questions</h2><p>Contact <a href={`mailto:${site.settings.email}`}>{site.settings.email}</a> if you have a question about this notice.</p></div></article>
</BaseLayout>
