{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "first-step-montessori",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "vars": {
    "SITE_ENV": "preview",
    "ADMIN_DEV_BYPASS": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "first-step-montessori-preview",
      "database_id": "197f2e6e-b6d4-4903-88dc-314e815c667a",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "garden": {
      "name": "first-step-montessori-garden-preview",
      "vars": { "SITE_ENV": "preview", "ADMIN_DEV_BYPASS": "false" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "first-step-montessori-preview",
          "database_id": "197f2e6e-b6d4-4903-88dc-314e815c667a",
          "migrations_dir": "migrations"
        }
      ]
    },
    "geometry": {
      "name": "first-step-montessori-geometry-preview",
      "vars": { "SITE_ENV": "preview", "ADMIN_DEV_BYPASS": "false" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "first-step-montessori-preview",
          "database_id": "197f2e6e-b6d4-4903-88dc-314e815c667a",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "first-step-montessori",
      "vars": { "SITE_ENV": "production", "ADMIN_DEV_BYPASS": "false" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "first-step-montessori-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
